# =========================================================
# OfficePilot - Application Environment Configuration
# =========================================================

# App Identifiers
VITE_APP_NAME=OfficePilot
VITE_APP_ENV=development
VITE_API_BASE_URL=

# =========================================================
# Firebase Public Configuration (Frontend / Client-side)
# Safe for client bundling. Never place private keys here.
# =========================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# =========================================================
# BACKEND ONLY CONFIGURATION (Vercel Serverless / Node.js)
# NEVER prefix with VITE_ or expose to browser client.
# =========================================================

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=officepilot

# Firebase Admin SDK (Server Service Account)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Groq LLM Inference (Deterministic Tool Orchestrator)
GROQ_API_KEY=gsk_...
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_REASONING=openai/gpt-oss-120b

# Cron Job Protection Secret
CRON_SECRET=super_secret_cron_token_min_32_chars

# Firebase Cloud Messaging (FCM Server Alerts)
FCM_SERVER_KEY=

